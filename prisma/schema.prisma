generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Activity {
  id        String   @id
  title     String
  startAt   DateTime @map("start_at")
  endAt     DateTime @map("end_at")
  category  String
  bookedBy  String   @default("") @map("booked_by")
  mapUrl    String?  @map("map_url")

  @@map("activities")
}
